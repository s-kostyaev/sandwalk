{
  "output_format": "markdown",
  "include_document_structure": true,
  "use_layout_for_markdown": true,
  "layout": {
    "strategy": "always",
    "apply_heuristics": true,
    "table_model": "tatr",
    "table_overlap_preference": "native",
    "enable_chart_understanding": false
  },
  "pdf_options": {
    "extract_images": false,
    "extract_tables": true,
    "ocr_inline_images": false,
    "reading_order": true,
    "hierarchy": {
      "enabled": true,
      "k_clusters": 6,
      "include_bbox": true
    }
  }
}
