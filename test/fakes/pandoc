#!/bin/sh
if [ "${1:-}" = "--version" ]; then
  printf '%s\n' 'pandoc fake-1.0'
  exit 0
fi

[ "${PANDOC_FORCE_FAILURE:-}" != 1 ] || {
  printf '%s\n' 'pandoc must not be called' >&2
  exit 70
}

[ -z "${PANDOC_TEST_LOG:-}" ] || printf '%s\n' "$*" >"$PANDOC_TEST_LOG"

output_format=
output_path=
header_path=
arxiv_filter=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --to=*)
      output_format=${1#--to=}
      ;;
    --to)
      shift
      output_format=${1:-}
      ;;
    --output=*)
      output_path=${1#--output=}
      ;;
    --output|-o)
      shift
      output_path=${1:-}
      ;;
    --lua-filter=*)
      arxiv_filter=true
      ;;
    --include-in-header=*)
      header_path=${1#--include-in-header=}
      ;;
  esac
  shift
done

[ -z "${PANDOC_TEST_HEADER_LOG:-}" ] ||
  [ -z "$header_path" ] ||
  cp "$header_path" "$PANDOC_TEST_HEADER_LOG"

if [ -n "$output_path" ] && [ "$output_format" != "gfm-raw_html" ]; then
  cat >"$output_path" <<'EOF'
%PDF-1.7
fake pandoc pdf
EOF
  exit 0
fi

[ "$output_format" = "gfm-raw_html" ] || {
  printf 'unexpected pandoc output format: %s\n' "$output_format" >&2
  exit 64
}

if [ "$arxiv_filter" = true ]; then
  output='# Fetched paper

## Introduction

One.

Two.

Three.

Four.

Five.

Six.

Seven.

Eight.'
else
  output='# Fetched title

Queryable body.'
fi

if [ -n "$output_path" ]; then
  printf '%s\n' "$output" >"$output_path"
else
  printf '%s\n' "$output"
fi
