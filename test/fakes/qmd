#!/bin/sh
set -eu

case "${1:-}" in
  update)
    mkdir -p .qmd
    printf '%s\n' 'fake project-local qmd database' >.qmd/index.sqlite
    ;;
  embed)
    [ -f .qmd/index.sqlite ]
    ;;
  query)
    case "${2:-}" in
      "vec: "*) ;;
      *) printf '%s\n' 'fake qmd requires one typed vec query' >&2; exit 64 ;;
    esac
    case " $* " in
      *" --no-rerank "*) ;;
      *) printf '%s\n' 'fake qmd requires --no-rerank' >&2; exit 64 ;;
    esac
    if [ -n "${QMD_FAKE_MATCH:-}" ]; then
      first=$(rg -l -F "$QMD_FAKE_MATCH" corpus | LC_ALL=C sort | head -1)
    else
      first=$(find corpus -type f -name '*.md' -print | LC_ALL=C sort | head -1)
    fi
    [ -n "$first" ] || exit 65
    title=$(sed -n '1{s/^# //;p;}' "$first")
    snippet=$(sed -n '3,5p' "$first" | tr '\n' ' ')
    jq -n --arg file "$PWD/$first" --arg title "$title" --arg snippet "$snippet" \
      '[{docid:"#fixture",score:0.91,file:$file,title:$title,snippet:$snippet}]'
    ;;
  --version)
    printf '%s\n' 'qmd 2.5.3-test'
    ;;
  *)
    printf '%s\n' 'unexpected fake qmd command' >&2
    exit 64
    ;;
esac
