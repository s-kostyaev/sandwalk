#!/usr/bin/env python3
"""Render one bounded retained rich-document page for sandwalk.visual-render.v1."""

from __future__ import annotations

import contextlib
import hashlib
import json
import os
import re
import shutil
import stat
import struct
import subprocess
import sys
import tempfile
from pathlib import Path


MAX_SOURCE_BYTES = 512 * 1024 * 1024
MAX_IMAGE_BYTES = 16 * 1024 * 1024
MAX_PAGES = 100_000
MAX_DIMENSION = 10_000
MAX_PIXELS = 20_000_000
PDF_PROFILE = "poppler-png-144dpi-v1"
OFFICE_PROFILE = "libreoffice-pdf-poppler-png-144dpi-v1"
OFFICE_FORMATS = {
    "rtf",
    "doc", "dot", "docm", "docx", "dotx", "dotm",
    "ppt", "pps", "pot", "pptx", "pptm", "ppsx", "ppsm", "potx", "potm",
    "xls", "xlt", "xlsm", "xlsx", "xltx", "xltm", "xlsb",
    "odt", "ott", "odp", "otp", "ods", "ots", "odg", "otg", "odf",
    "epub", "fb2", "vsd", "vsdx", "pub",
}
SUPPORTED_FORMATS = {"pdf", *OFFICE_FORMATS}


def fail(message: str, status: int = 65) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def run(arguments: list[str], timeout: int) -> subprocess.CompletedProcess[str]:
    environment = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin:/usr/local/bin"),
        "LC_ALL": "C",
    }
    try:
        return subprocess.run(
            arguments,
            check=True,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=environment,
        )
    except FileNotFoundError:
        fail(f"required document renderer is unavailable: {arguments[0]}", 69)
    except subprocess.TimeoutExpired:
        fail("document page rendering timed out", 69)
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or error.stdout or "document renderer failed").strip()
        fail(detail[:2000], 69)


def regular_nonsymlink(path: Path) -> os.stat_result:
    try:
        status = path.lstat()
    except OSError:
        fail(f"renderer artifact is unavailable: {path.name}")
    if not stat.S_ISREG(status.st_mode) or path.is_symlink():
        fail(f"renderer artifact must be a regular non-symlink file: {path.name}")
    return status


def convert_with_libreoffice(source: Path, workspace: Path) -> tuple[Path, str]:
    executable = shutil.which("soffice") or shutil.which("libreoffice")
    if executable is None:
        fail("LibreOffice is required to render this document format", 69)
    profile = workspace / "profile"
    converted = workspace / "converted"
    profile.mkdir(mode=0o700)
    converted.mkdir(mode=0o700)
    profile_uri = profile.resolve().as_uri()
    run(
        [
            executable,
            f"-env:UserInstallation={profile_uri}",
            "--headless",
            "--safe-mode",
            "--nologo",
            "--nodefault",
            "--nolockcheck",
            "--norestore",
            "--convert-to",
            "pdf",
            "--outdir",
            str(converted),
            str(source),
        ],
        180,
    )
    candidates = sorted(converted.glob("*.pdf"))
    if len(candidates) != 1:
        fail("LibreOffice did not publish exactly one converted PDF")
    converted_pdf = candidates[0]
    converted_status = regular_nonsymlink(converted_pdf)
    if not 5 <= converted_status.st_size <= MAX_SOURCE_BYTES:
        fail("converted PDF size is outside the supported bounds")
    with converted_pdf.open("rb") as stream:
        if stream.read(5) != b"%PDF-":
            fail("LibreOffice produced an invalid PDF")
    version = run(
        [executable, f"-env:UserInstallation={profile_uri}", "--version"], 10
    )
    version_text = (version.stdout or version.stderr).splitlines()[0].strip()[:128]
    return converted_pdf, version_text


def main() -> None:
    try:
        request = json.load(sys.stdin)
    except (json.JSONDecodeError, UnicodeDecodeError):
        fail("invalid visual-render request", 64)
    if not isinstance(request, dict) or request.get("protocol") != "sandwalk.visual-render.v1":
        fail("unsupported visual-render protocol", 64)
    source_value = request.get("source_document")
    source_format = request.get("source_format")
    output_value = request.get("output_directory")
    page = request.get("page")
    if (
        not isinstance(source_value, str)
        or not isinstance(output_value, str)
        or not isinstance(source_format, str)
    ):
        fail("visual-render paths must be strings", 64)
    if source_format not in SUPPORTED_FORMATS:
        fail("unsupported visual-render source format", 64)
    if not isinstance(page, int) or isinstance(page, bool) or not 1 <= page <= MAX_PAGES:
        fail("visual-render page is out of range", 64)

    source = Path(source_value)
    output = Path(output_value)
    try:
        source_status = source.stat()
    except OSError:
        fail("source document is unavailable", 66)
    if not stat.S_ISREG(source_status.st_mode) or source.is_symlink():
        fail("source document must be a regular non-symlink file", 66)
    if source_status.st_size < 1 or source_status.st_size > MAX_SOURCE_BYTES:
        fail("source document size is outside the supported bounds", 65)
    if source.suffix.lower() != f".{source_format}":
        fail("source document extension does not match source_format", 64)
    if source_format == "pdf":
        with source.open("rb") as stream:
            if stream.read(5) != b"%PDF-":
                fail("source artifact is not a PDF", 65)
    try:
        output.mkdir(mode=0o700, parents=False, exist_ok=False)
    except FileExistsError:
        fail("visual-render output directory already exists", 73)
    except OSError:
        fail("could not create visual-render output directory", 73)

    source_hash = sha256(source)
    with contextlib.ExitStack() as stack:
        pdf_source = source
        render_profile = PDF_PROFILE
        converter_version = ""
        if source_format != "pdf":
            conversion_directory = Path(
                stack.enter_context(
                    tempfile.TemporaryDirectory(prefix=".conversion-", dir=output)
                )
            )
            pdf_source, converter_version = convert_with_libreoffice(
                source, conversion_directory
            )
            retained_render_input = output / "render-input.pdf"
            shutil.copyfile(pdf_source, retained_render_input)
            regular_nonsymlink(retained_render_input)
            pdf_source = retained_render_input
            render_profile = OFFICE_PROFILE

        render_input_hash = sha256(pdf_source)

        info = run(
            ["pdfinfo", "-f", str(page), "-l", str(page), "-box", str(pdf_source)],
            15,
        )
        pages_match = re.search(r"^Pages:\s+(\d+)\s*$", info.stdout, re.MULTILINE)
        size_match = re.search(
            rf"^Page\s+{page}\s+size:\s+([0-9.]+)\s+x\s+([0-9.]+)\s+pts",
            info.stdout,
            re.MULTILINE,
        )
        if pages_match is None or size_match is None:
            fail("could not inspect the requested document page")
        page_count = int(pages_match.group(1))
        if not 1 <= page_count <= MAX_PAGES or page > page_count:
            fail("requested document page does not exist")
        estimated_width = int(float(size_match.group(1)) * 2 + 1)
        estimated_height = int(float(size_match.group(2)) * 2 + 1)
        if (
            estimated_width > MAX_DIMENSION
            or estimated_height > MAX_DIMENSION
            or estimated_width * estimated_height > MAX_PIXELS
        ):
            fail("requested document page exceeds raster bounds")

        image = output / "page.png"
        run(
            [
                "pdftocairo",
                "-png",
                "-singlefile",
                "-r",
                "144",
                "-f",
                str(page),
                "-l",
                str(page),
                str(pdf_source),
                str(output / "page"),
            ],
            60,
        )
    try:
        image_status = image.stat()
        with image.open("rb") as stream:
            header = stream.read(24)
    except OSError:
        fail("document renderer did not produce page.png")
    if not stat.S_ISREG(image_status.st_mode) or image.is_symlink():
        fail("rendered page must be a regular non-symlink file")
    if not 1 <= image_status.st_size <= MAX_IMAGE_BYTES:
        fail("rendered page exceeds the image-size bound")
    if len(header) != 24 or header[:8] != b"\x89PNG\r\n\x1a\n" or header[12:16] != b"IHDR":
        fail("document renderer produced an invalid PNG")
    width, height = struct.unpack(">II", header[16:24])
    if (
        not 1 <= width <= MAX_DIMENSION
        or not 1 <= height <= MAX_DIMENSION
        or width * height > MAX_PIXELS
    ):
        fail("rendered PNG dimensions exceed the supported bounds")

    version_output = run(["pdftocairo", "-v"], 5)
    poppler_version = (
        version_output.stderr or version_output.stdout
    ).splitlines()[0].strip()
    version_text = (
        f"{converter_version}; {poppler_version}"
        if converter_version
        else poppler_version
    )[:256]
    image_hash = sha256(image)
    manifest_path = output / "manifest.json"
    manifest = {
        "protocol": "sandwalk.visual-render-manifest.v1",
        "source_sha256": source_hash,
        "source_format": source_format,
        "render_input_sha256": render_input_hash,
        "page": page,
        "page_count": page_count,
        "artifact": "page.png",
        "image_sha256": image_hash,
        "image_size": image_status.st_size,
        "width": width,
        "height": height,
        "render_profile": render_profile,
        "renderer_version": version_text,
    }
    temporary_manifest = output / "manifest.json.tmp"
    temporary_manifest.write_text(
        json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n",
        encoding="utf-8",
    )
    os.replace(temporary_manifest, manifest_path)
    result = {
        "protocol": "sandwalk.visual-render-result.v1",
        "image_path": str(image),
        "manifest_path": str(manifest_path),
        "render_input_path": str(pdf_source),
        **{key: value for key, value in manifest.items() if key not in {"protocol", "artifact"}},
    }
    json.dump(result, sys.stdout, sort_keys=True, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
